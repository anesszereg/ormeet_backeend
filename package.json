{
  "name": "ormeet",
  "private": true,
  "workspaces": [
    "landing-page",
    "front-end",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev -w landing-page",
    "build:landing": "npm run build -w landing-page",
    "dev:platform": "npm run dev -w front-end",
    "build:platform": "npm run build -w front-end",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "next": "^16.1.6"
  }
}
